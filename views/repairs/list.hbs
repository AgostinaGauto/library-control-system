

<div class="container mt-4">
  <h2 class="mb-3"> Listado de Reparaciones</h2>

  <div class="mb-3">
    <a href="/repairs/add" class="btn btn-primary">➕ Nueva Reparación</a>
  </div>

  {{#if reparaciones.length}}
    <table class="table table-striped table-bordered">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Libro</th>
          <th>Motivo</th>
          <th>Fecha Ingreso</th>
          <th>Fecha Egreso</th>
          <th>Estado del Libro</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        {{#each reparaciones}}
          <tr>
            <td>{{this.id_reparacion}}</td>
            <td>{{#if this.libro}}{{this.libro.titulo}}{{else}}Libro eliminado{{/if}}</td>
            <td>{{this.motivo}}</td>
            <td>{{formatDate this.fecha_ingreso}}</td>
            <td>{{#if this.fecha_egreso}}{{formatDate this.fecha_egreso}}{{else}}—{{/if}}</td>
            <td>{{#if this.libro}}{{this.libro.estado}}{{else}}—{{/if}}</td>
            <td>
              <a href="/repairs/edit/{{this.id_reparacion}}" class="btn btn-warning btn-sm">✏️ Editar</a>
              <a href="/repairs/delete/{{this.id_reparacion}}" class="btn btn-danger btn-sm" onclick="return confirm('¿Seguro que deseas eliminar esta reparación?');">🗑️ Eliminar</a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p>No hay reparaciones registradas.</p>
  {{/if}}
</div>

